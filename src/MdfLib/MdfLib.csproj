<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0;net10.0</TargetFrameworks>
    <RepositoryProjectRole>Library</RepositoryProjectRole>
    <AssemblyName>MdfLibrary.Managed</AssemblyName>
    <RootNamespace>MdfLib</RootNamespace>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>MdfLibrary.Managed</PackageId>
    <PackageProjectUrl>https://github.com/sensboston/mdflib.net</PackageProjectUrl>
    <Description>Fully managed .NET port of the MdfLibrary (mdflib) .NET wrapper: read and write ASAM MDF 3.x/4.x, source-compatible drop-in for the native MdfLibrary; no native code.</Description>
    <PackageTags>mdf;mf4;asam;measurement;can</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/sensboston/mdflib.net</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
